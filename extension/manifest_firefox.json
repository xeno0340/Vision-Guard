{
  "manifest_version": 3,
  "name": "VisionGuard",
  "version": "0.1.0",
  "description": "Privacy-preserving vision agent - captures and redacts screen content locally before any server call.",
  "browser_specific_settings": {
    "gecko": {
      "id": "visionguard@sih2026.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "host_permissions": [
    "http://localhost:8000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "VisionGuard"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "optional_host_permissions": [
    "<all_urls>"
  ]
}